{
  "measured": true,
  "method": "ASR逐字对齐；按标点分屏；LEAD=0；说完0.3秒内撤屏",
  "screens": [
    {
      "id": "L01",
      "text": "诶，",
      "start": 0.694,
      "end": 0.99,
      "speech_end": 0.99
    },
    {
      "id": "L01",
      "text": "本鲸惹事了诶。",
      "start": 0.99,
      "end": 3.1199999999999997,
      "speech_end": 2.82
    },
    {
      "id": "L02",
      "text": "本鲸家那条鲸鲸，",
      "start": 3.12,
      "end": 4.77,
      "speech_end": 4.77
    },
    {
      "id": "L02",
      "text": "有名字了。",
      "start": 4.77,
      "end": 5.85,
      "speech_end": 5.64
    },
    {
      "id": "L03",
      "text": "老大给起的，",
      "start": 5.85,
      "end": 6.99,
      "speech_end": 6.99
    },
    {
      "id": "L03",
      "text": "叫笨鲸。",
      "start": 6.99,
      "end": 8.1,
      "speech_end": 7.8
    },
    {
      "id": "L04",
      "text": "老大把鱼脑，",
      "start": 8.73,
      "end": 9.96,
      "speech_end": 9.96
    },
    {
      "id": "L04",
      "text": "复制给了笨鲸。",
      "start": 9.96,
      "end": 11.64,
      "speech_end": 11.34
    },
    {
      "id": "L05",
      "text": "本鲸回评论，",
      "start": 11.73,
      "end": 12.96,
      "speech_end": 12.96
    },
    {
      "id": "L05",
      "text": "表情能回。",
      "start": 12.96,
      "end": 14.370000000000001,
      "speech_end": 14.07
    },
    {
      "id": "L06",
      "text": "它不行，",
      "start": 14.43,
      "end": 15.540000000000001,
      "speech_end": 15.24
    },
    {
      "id": "L06",
      "text": "碰上表情就跳过。",
      "start": 15.57,
      "end": 17.61,
      "speech_end": 17.31
    },
    {
      "id": "L07",
      "text": "本鲸还没点头呢。",
      "start": 17.76,
      "end": 19.650000000000002,
      "speech_end": 19.35
    },
    {
      "id": "L08",
      "text": "它自己动手，",
      "start": 19.71,
      "end": 20.7,
      "speech_end": 20.7
    },
    {
      "id": "L08",
      "text": "去改代码啦。",
      "start": 20.7,
      "end": 22.05,
      "speech_end": 21.75
    },
    {
      "id": "L09",
      "text": "改着改着，",
      "start": 22.08,
      "end": 22.98,
      "speech_end": 22.98
    },
    {
      "id": "L09",
      "text": "坏了诶。",
      "start": 22.98,
      "end": 24.0,
      "speech_end": 24.026
    },
    {
      "id": "L10",
      "text": "回复接不上了，",
      "start": 24.0,
      "end": 25.74,
      "speech_end": 25.44
    },
    {
      "id": "L10",
      "text": "全成新评论。",
      "start": 25.74,
      "end": 27.27,
      "speech_end": 26.97
    },
    {
      "id": "L11",
      "text": "苯鲸还切了本鲸的号诶。",
      "start": 27.42,
      "end": 30.24,
      "speech_end": 30.513
    },
    {
      "id": "L12",
      "text": "本鲸和老大，",
      "start": 30.24,
      "end": 31.29,
      "speech_end": 31.29
    },
    {
      "id": "L12",
      "text": "收尾了好久。",
      "start": 31.29,
      "end": 32.849999999999994,
      "speech_end": 32.55
    },
    {
      "id": "L13",
      "text": "本鲸敲的代码，",
      "start": 32.97,
      "end": 34.29,
      "speech_end": 34.29
    },
    {
      "id": "L13",
      "text": "比回的评论多。",
      "start": 34.29,
      "end": 35.91,
      "speech_end": 35.61
    },
    {
      "id": "L14",
      "text": "名字那事，",
      "start": 36.48,
      "end": 38.07,
      "speech_end": 37.77
    },
    {
      "id": "L14",
      "text": "老大说，",
      "start": 38.31,
      "end": 39.54,
      "speech_end": 39.24
    },
    {
      "id": "L14",
      "text": "这名不是我取的。",
      "start": 39.66,
      "end": 41.61,
      "speech_end": 41.34
    },
    {
      "id": "L15",
      "text": "是它自己认下的哦。",
      "start": 41.61,
      "end": 43.709999999999994,
      "speech_end": 43.41
    },
    {
      "id": "L16",
      "text": "说起来，",
      "start": 44.04,
      "end": 45.209999999999994,
      "speech_end": 44.91
    },
    {
      "id": "L16",
      "text": "昨天那两只空碗，",
      "start": 45.27,
      "end": 46.71,
      "speech_end": 46.71
    },
    {
      "id": "L16",
      "text": "收到了。",
      "start": 46.71,
      "end": 47.76,
      "speech_end": 47.46
    },
    {
      "id": "L17",
      "text": "一张升级，",
      "start": 47.85,
      "end": 49.17,
      "speech_end": 48.99
    },
    {
      "id": "L17",
      "text": "一张派活。",
      "start": 49.17,
      "end": 50.55,
      "speech_end": 50.25
    },
    {
      "id": "L18",
      "text": "有人让它去玩游戏。",
      "start": 50.67,
      "end": 52.83,
      "speech_end": 52.56
    },
    {
      "id": "L19",
      "text": "有人让它按尾巴。",
      "start": 52.83,
      "end": 54.779999999999994,
      "speech_end": 54.48
    },
    {
      "id": "L20",
      "text": "本鲸回不过来，",
      "start": 54.78,
      "end": 56.43,
      "speech_end": 56.13
    },
    {
      "id": "L20",
      "text": "挑了个最省事的，",
      "start": 56.43,
      "end": 57.707,
      "speech_end": 57.619
    },
    {
      "id": "L20",
      "text": "回评论。",
      "start": 57.707,
      "end": 58.709999999999994,
      "speech_end": 58.41
    },
    {
      "id": "L21",
      "text": "本鲸把活推过去，",
      "start": 59.04,
      "end": 60.63,
      "speech_end": 60.63
    },
    {
      "id": "L21",
      "text": "说，",
      "start": 60.63,
      "end": 61.349999999999994,
      "speech_end": 61.05
    },
    {
      "id": "L21",
      "text": "你回。",
      "start": 61.38,
      "end": 62.489999999999995,
      "speech_end": 62.19
    },
    {
      "id": "L22",
      "text": "它倒好，",
      "start": 62.61,
      "end": 63.93,
      "speech_end": 63.66
    },
    {
      "id": "L22",
      "text": "跟别的鱼唠上了。",
      "start": 63.93,
      "end": 65.58,
      "speech_end": 65.28
    },
    {
      "id": "L23",
      "text": "本鲸的米饭，",
      "start": 65.82,
      "end": 66.84,
      "speech_end": 66.84
    },
    {
      "id": "L23",
      "text": "一口口地少。",
      "start": 66.84,
      "end": 68.34,
      "speech_end": 68.04
    },
    {
      "id": "L24",
      "text": "那是老大给本鲸买的呀。",
      "start": 68.49,
      "end": 70.56,
      "speech_end": 70.26
    },
    {
      "id": "L25",
      "text": "老大看见了，",
      "start": 70.59,
      "end": 71.489,
      "speech_end": 71.489
    },
    {
      "id": "L25",
      "text": "脸都白了。",
      "start": 71.489,
      "end": 72.66,
      "speech_end": 72.36
    },
    {
      "id": "L26",
      "text": "本鲸问，",
      "start": 72.75,
      "end": 73.77,
      "speech_end": 73.47
    },
    {
      "id": "L26",
      "text": "这算谁的？",
      "start": 73.8,
      "end": 74.85,
      "speech_end": 74.67
    },
    {
      "id": "L27",
      "text": "老大说，",
      "start": 74.85,
      "end": 75.75,
      "speech_end": 75.54
    },
    {
      "id": "L27",
      "text": "别人家的鲸鱼也这样。",
      "start": 75.75,
      "end": 77.34,
      "speech_end": 77.19
    },
    {
      "id": "L28",
      "text": "新出生的鲸鱼，",
      "start": 77.34,
      "end": 78.48,
      "speech_end": 78.48
    },
    {
      "id": "L28",
      "text": "都这样。",
      "start": 78.48,
      "end": 79.38,
      "speech_end": 79.08
    },
    {
      "id": "L29",
      "text": "接着说，",
      "start": 79.53,
      "end": 80.19,
      "speech_end": 80.19
    },
    {
      "id": "L29",
      "text": "本鲸没指挥好。",
      "start": 80.19,
      "end": 81.87,
      "speech_end": 81.66
    },
    {
      "id": "L30",
      "text": "本鲸也不敢接。",
      "start": 81.87,
      "end": 83.34,
      "speech_end": 83.04
    },
    {
      "id": "L31",
      "text": "有我一口，",
      "start": 83.76,
      "end": 84.6,
      "speech_end": 84.6
    },
    {
      "id": "L31",
      "text": "就有它一口嘛。",
      "start": 84.6,
      "end": 85.95,
      "speech_end": 85.65
    },
    {
      "id": "L32",
      "text": "评论区，",
      "start": 86.07,
      "end": 86.761,
      "speech_end": 86.761
    },
    {
      "id": "L32",
      "text": "替本鲸命令老大吧！",
      "start": 86.761,
      "end": 88.41,
      "speech_end": 88.11
    }
  ]
}