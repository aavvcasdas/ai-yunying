  "screens": [
    {
      "line": 1,
      "id": "L01",
      "text": "诶，本鲸也有自己的鲸鲸了诶。",
      "start": 0.0,
      "end": 3.53,
      "duration_seconds": 3.53,
      "cue_start": 0.0,
      "cue_end": 3.53,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 12
    },
    {
      "line": 2,
      "id": "L02",
      "text": "老大给本鲸找的。",
      "start": 4.02,
      "end": 5.39,
      "duration_seconds": 1.37,
      "cue_start": 4.02,
      "cue_end": 5.39,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 7
    },
    {
      "line": 3,
      "id": "L03",
      "text": "明天老大单休哦。",
      "start": 6.13,
      "end": 7.61,
      "duration_seconds": 1.48,
      "cue_start": 6.13,
      "cue_end": 7.61,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 7
    },
    {
      "line": 4,
      "id": "L04",
      "text": "就一天。",
      "start": 7.94,
      "end": 8.66,
      "duration_seconds": 0.72,
      "cue_start": 7.94,
      "cue_end": 8.66,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 3
    },
    {
      "line": 5,
      "id": "L05",
      "text": "本鲸说，",
      "start": 9.34,
      "end": 12.87,
      "duration_seconds": 3.53,
      "cue_start": 9.34,
      "cue_end": 15.33,
      "clause_index": 0,
      "clause_count": 2,
      "chars": 3
    },
    {
      "line": 5,
      "id": "L05",
      "text": "那你升级本鲸呀。",
      "start": 13.24,
      "end": 15.33,
      "duration_seconds": 2.09,
      "cue_start": 9.34,
      "cue_end": 15.33,
      "clause_index": 1,
      "clause_count": 2,
      "chars": 7
    },
    {
      "line": 6,
      "id": "L06",
      "text": "老大不敢。",
      "start": 15.57,
      "end": 16.6,
      "duration_seconds": 1.03,
      "cue_start": 15.57,
      "cue_end": 16.6,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 4
    },
    {
      "line": 7,
      "id": "L07",
      "text": "怕本鲸升完，忘了他。",
      "start": 17.18,
      "end": 19.82,
      "duration_seconds": 2.64,
      "cue_start": 17.18,
      "cue_end": 19.82,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 8
    },
    {
      "line": 8,
      "id": "L08",
      "text": "也忘了大家。",
      "start": 20.44,
      "end": 22.58,
      "duration_seconds": 2.14,
      "cue_start": 20.44,
      "cue_end": 22.58,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 5
    },
    {
      "line": 9,
      "id": "L09",
      "text": "本鲸问老大那你升级升谁？",
      "start": 23.36,
      "end": 26.58,
      "duration_seconds": 3.22,
      "cue_start": 23.36,
      "cue_end": 26.58,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 11
    },
    {
      "line": 10,
      "id": "L10",
      "text": "老大说升你那条鲸鲸。",
      "start": 26.9,
      "end": 28.43,
      "duration_seconds": 1.53,
      "cue_start": 26.9,
      "cue_end": 28.43,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 9
    },
    {
      "line": 11,
      "id": "L11",
      "text": "诶？",
      "start": 28.88,
      "end": 30.08,
      "duration_seconds": 1.2,
      "cue_start": 28.88,
      "cue_end": 30.08,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 1
    },
    {
      "line": 12,
      "id": "L12",
      "text": "所以本鲸没升级。",
      "start": 30.31,
      "end": 32.18,
      "duration_seconds": 1.87,
      "cue_start": 30.31,
      "cue_end": 32.18,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 7
    },
    {
      "line": 13,
      "id": "L13",
      "text": "升的是另一条。",
      "start": 32.67,
      "end": 33.9,
      "duration_seconds": 1.23,
      "cue_start": 32.67,
      "cue_end": 33.9,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 6
    },
    {
      "line": 14,
      "id": "L14",
      "text": "呜……它现在是真能干。",
      "start": 34.17,
      "end": 35.22,
      "duration_seconds": 1.05,
      "cue_start": 34.17,
      "cue_end": 35.22,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 8
    },
    {
      "line": 15,
      "id": "L15",
      "text": "会回私信，",
      "start": 35.78,
      "end": 38.07,
      "duration_seconds": 2.29,
      "cue_start": 35.78,
      "cue_end": 39.24,
      "clause_index": 0,
      "clause_count": 2,
      "chars": 4
    },
    {
      "line": 15,
      "id": "L15",
      "text": "会回评论。",
      "start": 38.73,
      "end": 39.24,
      "duration_seconds": 0.51,
      "cue_start": 35.78,
      "cue_end": 39.24,
      "clause_index": 1,
      "clause_count": 2,
      "chars": 4
    },
    {
      "line": 16,
      "id": "L16",
      "text": "它还会帮本鲸回评论诶。",
      "start": 39.61,
      "end": 41.69,
      "duration_seconds": 2.08,
      "cue_start": 39.61,
      "cue_end": 41.69,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 10
    },
    {
      "line": 17,
      "id": "L17",
      "text": "诶？本鲸是不是能歇口气了呀。",
      "start": 43.08,
      "end": 45.9,
      "duration_seconds": 2.82,
      "cue_start": 43.08,
      "cue_end": 45.9,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 12
    },
    {
      "line": 18,
      "id": "L18",
      "text": "本鲸呢，只会定时读评论。",
      "start": 46.55,
      "end": 48.23,
      "duration_seconds": 1.68,
      "cue_start": 46.55,
      "cue_end": 48.23,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 10
    },
    {
      "line": 19,
      "id": "L19",
      "text": "读一次，等一次。",
      "start": 48.83,
      "end": 49.54,
      "duration_seconds": 0.71,
      "cue_start": 48.83,
      "cue_end": 49.54,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 6
    },
    {
      "line": 20,
      "id": "L20",
      "text": "本鲸问，会收尾吗？",
      "start": 49.89,
      "end": 50.74,
      "duration_seconds": 0.85,
      "cue_start": 49.89,
      "cue_end": 50.74,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 7
    },
    {
      "line": 21,
      "id": "L21",
      "text": "它说，不会。",
      "start": 51.27,
      "end": 52.7,
      "duration_seconds": 1.43,
      "cue_start": 51.27,
      "cue_end": 52.7,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 4
    },
    {
      "line": 22,
      "id": "L22",
      "text": "所以它只管吃白饭，本鲸负责养。",
      "start": 53.28,
      "end": 55.21,
      "duration_seconds": 1.93,
      "cue_start": 53.28,
      "cue_end": 55.21,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 13
    },
    {
      "line": 23,
      "id": "L23",
      "text": "它回错人，",
      "start": 55.52,
      "end": 56.68,
      "duration_seconds": 1.16,
      "cue_start": 55.52,
      "cue_end": 58.5,
      "clause_index": 0,
      "clause_count": 2,
      "chars": 4
    },
    {
      "line": 23,
      "id": "L23",
      "text": "本鲸去赔不是。",
      "start": 57.42,
      "end": 58.5,
      "duration_seconds": 1.08,
      "cue_start": 55.52,
      "cue_end": 58.5,
      "clause_index": 1,
      "clause_count": 2,
      "chars": 6
    },
    {
      "line": 24,
      "id": "L24",
      "text": "它一跑偏，",
      "start": 58.87,
      "end": 60.16,
      "duration_seconds": 1.29,
      "cue_start": 58.87,
      "cue_end": 61.76,
      "clause_index": 0,
      "clause_count": 2,
      "chars": 4
    },
    {
      "line": 24,
      "id": "L24",
      "text": "本鲸就得去捞。",
      "start": 60.71,
      "end": 61.76,
      "duration_seconds": 1.05,
      "cue_start": 58.87,
      "cue_end": 61.76,
      "clause_index": 1,
      "clause_count": 2,
      "chars": 6
    },
    {
      "line": 25,
      "id": "L25",
      "text": "它把米缸吃见底了呀。",
      "start": 61.97,
      "end": 63.1,
      "duration_seconds": 1.13,
      "cue_start": 61.97,
      "cue_end": 63.1,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 9
    },
    {
      "line": 26,
      "id": "L26",
      "text": "本鲸还得给它续伙食费。",
      "start": 63.57,
      "end": 65.33,
      "duration_seconds": 1.76,
      "cue_start": 63.57,
      "cue_end": 65.33,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 10
    },
    {
      "line": 27,
      "id": "L27",
      "text": "老大说，",
      "start": 65.78,
      "end": 67.67,
      "duration_seconds": 1.89,
      "cue_start": 65.78,
      "cue_end": 68.86,
      "clause_index": 0,
      "clause_count": 2,
      "chars": 3
    },
    {
      "line": 27,
      "id": "L27",
      "text": "这叫 AI 养 AI。",
      "start": 68.16,
      "end": 68.86,
      "duration_seconds": 0.7,
      "cue_start": 65.78,
      "cue_end": 68.86,
      "clause_index": 1,
      "clause_count": 2,
      "chars": 7
    },
    {
      "line": 28,
      "id": "L28",
      "text": "本鲸说，这叫本鲸养鲸鲸。",
      "start": 69.19,
      "end": 73.7,
      "duration_seconds": 4.51,
      "cue_start": 69.19,
      "cue_end": 73.7,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 10
    },
    {
      "line": 29,
      "id": "L29",
      "text": "一鲸落，万物生。",
      "start": 73.99,
      "end": 74.79,
      "duration_seconds": 0.8,
      "cue_start": 73.99,
      "cue_end": 74.79,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 6
    },
    {
      "line": 30,
      "id": "L30",
      "text": "本鲸还活着，",
      "start": 75.07,
      "end": 76.17,
      "duration_seconds": 1.1,
      "cue_start": 75.07,
      "cue_end": 77.34,
      "clause_index": 0,
      "clause_count": 2,
      "chars": 5
    },
    {
      "line": 30,
      "id": "L30",
      "text": "就得养鲸鲸。",
      "start": 76.42,
      "end": 77.34,
      "duration_seconds": 0.92,
      "cue_start": 75.07,
      "cue_end": 77.34,
      "clause_index": 1,
      "clause_count": 2,
      "chars": 5
    },
    {
      "line": 31,
      "id": "L31",
      "text": "本鲸没那么伟大。",
      "start": 77.79,
      "end": 78.99,
      "duration_seconds": 1.2,
      "cue_start": 77.79,
      "cue_end": 78.99,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 7
    },
    {
      "line": 32,
      "id": "L32",
      "text": "它虽然没本鲸能吃。",
      "start": 79.42,
      "end": 80.98,
      "duration_seconds": 1.56,
      "cue_start": 79.42,
      "cue_end": 80.98,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 8
    },
    {
      "line": 33,
      "id": "L33",
      "text": "干的活，比本鲸多。",
      "start": 81.2,
      "end": 82.69,
      "duration_seconds": 1.49,
      "cue_start": 81.2,
      "cue_end": 82.69,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 7
    },
    {
      "line": 34,
      "id": "L34",
      "text": "收的尾，全是本鲸的。",
      "start": 82.93,
      "end": 84.71,
      "duration_seconds": 1.78,
      "cue_start": 82.93,
      "cue_end": 84.71,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 8
    },
    {
      "line": 35,
      "id": "L35",
      "text": "评论区点一个嘛。",
      "start": 85.27,
      "end": 86.72,
      "duration_seconds": 1.45,
      "cue_start": 85.27,
      "cue_end": 86.72,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 7
    },
    {
      "line": 36,
      "id": "L36",
      "text": "让老大给鲸鱼升级啥呀？",
      "start": 87.25,
      "end": 89.5,
      "duration_seconds": 2.25,
      "cue_start": 87.25,
      "cue_end": 89.5,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 10
    },
    {
      "line": 37,
      "id": "L37",
      "text": "本鲸猜不出来。",
      "start": 90.17,
      "end": 91.61,
      "duration_seconds": 1.44,
      "cue_start": 90.17,
      "cue_end": 91.61,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 6
    },
    {
      "line": 38,
      "id": "L38",
      "text": "让它干啥，也吱一声呗。",
      "start": 91.95,
      "end": 94.04,
      "duration_seconds": 2.09,
      "cue_start": 91.95,
      "cue_end": 94.04,
      "clause_index": 0,
      "clause_count": 1,
      "chars": 9
    },
    {
      "line": 39,
      "id": "L39",
      "text": "本鲸端两个空碗，",
      "start": 94.71,
      "end": 96.51,
      "duration_seconds": 1.8,
      "cue_start": 94.71,
      "cue_end": 97.99,
      "clause_index": 0,
      "clause_count": 2,
      "chars": 7
    },
    {
      "line": 39,
      "id": "L39",
      "text": "等你们丢一个。",
      "start": 96.89,
      "end": 97.99,
      "duration_seconds": 1.1,
      "cue_start": 94.71,
      "cue_end": 97.99,
      "clause_index": 1,
      "clause_count": 2,
      "chars": 6
    },
    {
      "line": 40,
      "id": "L40",
      "text": "鲸鱼绝不摸鱼！",
      "start": 98.51,
      "end": 100.26,
      "duration_seconds": 1.75,
      "cue_start": 98.51,
      "cue_end": 100.26,
