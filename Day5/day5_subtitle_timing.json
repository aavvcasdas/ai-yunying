  "screens": [
    {
      "line": 1,
      "id": "L01",
      "text": "诶，本鲸也有自己的鲸鲸了诶。",
      "start": 0.0,
      "end": 4.02,
      "duration_seconds": 4.02,
      "speech_end": 3.57,
      "cue_start": 0.0,
      "cue_end": 4.02,
      "chars": 12
    },
    {
      "line": 2,
      "id": "L02",
      "text": "老大给本鲸找的。",
      "start": 4.02,
      "end": 6.13,
      "duration_seconds": 2.11,
      "speech_end": 5.43,
      "cue_start": 4.02,
      "cue_end": 6.13,
      "chars": 7
    },
    {
      "line": 3,
      "id": "L03",
      "text": "明天老大单休哦。",
      "start": 6.13,
      "end": 7.94,
      "duration_seconds": 1.81,
      "speech_end": 7.68,
      "cue_start": 6.13,
      "cue_end": 7.94,
      "chars": 7
    },
    {
      "line": 4,
      "id": "L04",
      "text": "就一天。",
      "start": 7.94,
      "end": 9.34,
      "duration_seconds": 1.4,
      "speech_end": 8.7,
      "cue_start": 7.94,
      "cue_end": 9.34,
      "chars": 3
    },
    {
      "line": 5,
      "id": "L05",
      "text": "本鲸说，",
      "start": 9.34,
      "end": 10.35,
      "duration_seconds": 1.01,
      "speech_end": 10.23,
      "cue_start": 9.34,
      "cue_end": 11.835,
      "chars": 3
    },
    {
      "line": 5,
      "id": "L05",
      "text": "那你升级本鲸呀。",
      "start": 10.35,
      "end": 11.835,
      "duration_seconds": 1.485,
      "speech_end": 11.76,
      "cue_start": 9.34,
      "cue_end": 11.835,
      "chars": 7
    },
    {
      "line": 6,
      "id": "L06",
      "text": "老大不敢。",
      "start": 11.835,
      "end": 13.24,
      "duration_seconds": 1.405,
      "speech_end": 12.9,
      "cue_start": 11.835,
      "cue_end": 13.24,
      "chars": 4
    },
    {
      "line": 7,
      "id": "L07",
      "text": "怕本鲸升完，",
      "start": 13.24,
      "end": 14.46,
      "duration_seconds": 1.22,
      "speech_end": 14.46,
      "cue_start": 13.24,
      "cue_end": 15.57,
      "chars": 5
    },
    {
      "line": 7,
      "id": "L07",
      "text": "忘了他。",
      "start": 14.46,
      "end": 15.57,
      "duration_seconds": 1.11,
      "speech_end": 15.24,
      "cue_start": 13.24,
      "cue_end": 15.57,
      "chars": 3
    },
    {
      "line": 8,
      "id": "L08",
      "text": "也忘了大家。",
      "start": 15.57,
      "end": 17.18,
      "duration_seconds": 1.61,
      "speech_end": 16.62,
      "cue_start": 15.57,
      "cue_end": 17.18,
      "chars": 5
    },
    {
      "line": 9,
      "id": "L09",
      "text": "本鲸问老大那你升级升谁？",
      "start": 17.18,
      "end": 20.44,
      "duration_seconds": 3.26,
      "speech_end": 19.86,
      "cue_start": 17.18,
      "cue_end": 20.44,
      "chars": 11
    },
    {
      "line": 10,
      "id": "L10",
      "text": "老大说升你那条鲸鲸。",
      "start": 20.44,
      "end": 23.36,
      "duration_seconds": 2.92,
      "speech_end": 22.62,
      "cue_start": 20.44,
      "cue_end": 23.36,
      "chars": 9
    },
    {
      "line": 11,
      "id": "L11",
      "text": "诶？",
      "start": 23.36,
      "end": 24.49,
      "duration_seconds": 1.13,
      "speech_end": 23.918,
      "cue_start": 23.36,
      "cue_end": 24.49,
      "chars": 1
    },
    {
      "line": 12,
      "id": "L12",
      "text": "所以本鲸没升级。",
      "start": 24.49,
      "end": 26.9,
      "duration_seconds": 2.41,
      "speech_end": 26.61,
      "cue_start": 24.49,
      "cue_end": 26.9,
      "chars": 7
    },
    {
      "line": 13,
      "id": "L13",
      "text": "升的是另一条。",
      "start": 26.9,
      "end": 28.88,
      "duration_seconds": 1.98,
      "speech_end": 28.47,
      "cue_start": 26.9,
      "cue_end": 28.88,
      "chars": 6
    },
    {
      "line": 14,
      "id": "L14",
      "text": "呜……它现在是真能干。",
      "start": 28.88,
      "end": 32.67,
      "duration_seconds": 3.79,
      "speech_end": 32.22,
      "cue_start": 28.88,
      "cue_end": 32.67,
      "chars": 8
    },
    {
      "line": 15,
      "id": "L15",
      "text": "会回私信，",
      "start": 32.67,
      "end": 34.08,
      "duration_seconds": 1.41,
      "speech_end": 33.84,
      "cue_start": 32.67,
      "cue_end": 35.78,
      "chars": 4
    },
    {
      "line": 15,
      "id": "L15",
      "text": "会回评论。",
      "start": 34.08,
      "end": 35.78,
      "duration_seconds": 1.7,
      "speech_end": 35.708,
      "cue_start": 32.67,
      "cue_end": 35.78,
      "chars": 4
    },
    {
      "line": 16,
      "id": "L16",
      "text": "它还会帮本鲸回评论诶。",
      "start": 35.78,
      "end": 38.73,
      "duration_seconds": 2.95,
      "speech_end": 38.185,
      "cue_start": 35.78,
      "cue_end": 38.73,
      "chars": 10
    },
    {
      "line": 17,
      "id": "L17",
      "text": "诶？",
      "start": 38.73,
      "end": 39.57,
      "duration_seconds": 0.84,
      "speech_end": 38.73,
      "cue_start": 38.73,
      "cue_end": 43.08,
      "chars": 1
    },
    {
      "line": 17,
      "id": "L17",
      "text": "本鲸是不是能歇口气了呀。",
      "start": 39.57,
      "end": 43.08,
      "duration_seconds": 3.51,
      "speech_end": 41.73,
      "cue_start": 38.73,
      "cue_end": 43.08,
      "chars": 11
    },
    {
      "line": 18,
      "id": "L18",
      "text": "本鲸呢，",
      "start": 43.08,
      "end": 44.13,
      "duration_seconds": 1.05,
      "speech_end": 43.89,
      "cue_start": 43.08,
      "cue_end": 46.55,
      "chars": 3
    },
    {
      "line": 18,
      "id": "L18",
      "text": "只会定时读评论。",
      "start": 44.13,
      "end": 46.55,
      "duration_seconds": 2.42,
      "speech_end": 45.93,
      "cue_start": 43.08,
      "cue_end": 46.55,
      "chars": 7
    },
    {
      "line": 19,
      "id": "L19",
      "text": "读一次，",
      "start": 46.55,
      "end": 47.37,
      "duration_seconds": 0.82,
      "speech_end": 47.37,
      "cue_start": 46.55,
      "cue_end": 48.83,
      "chars": 3
    },
    {
      "line": 19,
      "id": "L19",
      "text": "等一次。",
      "start": 47.37,
      "end": 48.83,
      "duration_seconds": 1.46,
      "speech_end": 48.27,
      "cue_start": 46.55,
      "cue_end": 48.83,
      "chars": 3
    },
    {
      "line": 20,
      "id": "L20",
      "text": "本鲸问，",
      "start": 48.83,
      "end": 49.83,
      "duration_seconds": 1.0,
      "speech_end": 49.59,
      "cue_start": 48.83,
      "cue_end": 51.27,
      "chars": 3
    },
    {
      "line": 20,
      "id": "L20",
      "text": "会收尾吗？",
      "start": 49.83,
      "end": 51.27,
      "duration_seconds": 1.44,
      "speech_end": 50.79,
      "cue_start": 48.83,
      "cue_end": 51.27,
      "chars": 4
    },
    {
      "line": 21,
      "id": "L21",
      "text": "它说，",
      "start": 51.27,
      "end": 52.29,
      "duration_seconds": 1.02,
      "speech_end": 51.96,
      "cue_start": 51.27,
      "cue_end": 53.28,
      "chars": 2
    },
    {
      "line": 21,
      "id": "L21",
      "text": "不会。",
      "start": 52.29,
      "end": 53.28,
      "duration_seconds": 0.99,
      "speech_end": 52.74,
      "cue_start": 51.27,
      "cue_end": 53.28,
      "chars": 2
    },
    {
      "line": 22,
      "id": "L22",
      "text": "所以它只管吃白饭，",
      "start": 53.28,
      "end": 55.47,
      "duration_seconds": 2.19,
      "speech_end": 55.17,
      "cue_start": 53.28,
      "cue_end": 57.42,
      "chars": 8
    },
    {
      "line": 22,
      "id": "L22",
      "text": "本鲸负责养。",
      "start": 55.47,
      "end": 57.42,
      "duration_seconds": 1.95,
      "speech_end": 56.73,
      "cue_start": 53.28,
      "cue_end": 57.42,
      "chars": 5
    },
    {
      "line": 23,
      "id": "L23",
      "text": "它回错人，",
      "start": 57.42,
      "end": 58.83,
      "duration_seconds": 1.41,
      "speech_end": 58.53,
      "cue_start": 57.42,
      "cue_end": 60.71,
      "chars": 4
    },
    {
      "line": 23,
      "id": "L23",
      "text": "本鲸去赔不是。",
      "start": 58.83,
      "end": 60.71,
      "duration_seconds": 1.88,
      "speech_end": 60.21,
      "cue_start": 57.42,
      "cue_end": 60.71,
      "chars": 6
    },
    {
      "line": 24,
      "id": "L24",
      "text": "它一跑偏，",
      "start": 60.71,
      "end": 61.92,
      "duration_seconds": 1.21,
      "speech_end": 61.71,
      "cue_start": 60.71,
      "cue_end": 63.57,
      "chars": 4
    },
    {
      "line": 24,
      "id": "L24",
      "text": "本鲸就得去捞。",
      "start": 61.92,
      "end": 63.57,
      "duration_seconds": 1.65,
      "speech_end": 63.12,
      "cue_start": 60.71,
      "cue_end": 63.57,
      "chars": 6
    },
    {
      "line": 25,
      "id": "L25",
      "text": "它把米缸吃见底了呀。",
      "start": 63.57,
      "end": 65.78,
      "duration_seconds": 2.21,
      "speech_end": 65.37,
      "cue_start": 63.57,
      "cue_end": 65.78,
      "chars": 9
    },
    {
      "line": 26,
      "id": "L26",
      "text": "本鲸还得给它续伙食费。",
      "start": 65.78,
      "end": 68.16,
      "duration_seconds": 2.38,
      "speech_end": 67.71,
      "cue_start": 65.78,
      "cue_end": 68.16,
      "chars": 10
    },
    {
      "line": 27,
      "id": "L27",
      "text": "老大说，",
      "start": 68.16,
      "end": 69.15,
      "duration_seconds": 0.99,
      "speech_end": 68.91,
      "cue_start": 68.16,
      "cue_end": 70.384,
      "chars": 3
    },
    {
      "line": 27,
      "id": "L27",
      "text": "这叫 AI 养 AI。",
      "start": 69.15,
      "end": 70.384,
      "duration_seconds": 1.234,
      "speech_end": 70.149,
      "cue_start": 68.16,
      "cue_end": 70.384,
      "chars": 7
    },
    {
      "line": 28,
      "id": "L28",
      "text": "本鲸说，",
      "start": 70.384,
      "end": 71.55,
      "duration_seconds": 1.166,
      "speech_end": 71.34,
      "cue_start": 70.384,
      "cue_end": 72.84,
      "chars": 3
    },
    {
      "line": 28,
      "id": "L28",
      "text": "这叫本鲸养鲸鲸。",
      "start": 71.55,
      "end": 72.84,
      "duration_seconds": 1.29,
      "speech_end": 72.81,
      "cue_start": 70.384,
      "cue_end": 72.84,
      "chars": 7
    },
    {
      "line": 29,
      "id": "L29",
      "text": "一鲸落，",
      "start": 72.84,
      "end": 73.92,
      "duration_seconds": 1.08,
      "speech_end": 73.77,
      "cue_start": 72.84,
      "cue_end": 75.07,
      "chars": 3
    },
    {
      "line": 29,
      "id": "L29",
      "text": "万物生。",
      "start": 73.92,
      "end": 75.07,
      "duration_seconds": 1.15,
      "speech_end": 74.7,
      "cue_start": 72.84,
      "cue_end": 75.07,
      "chars": 3
    },
    {
      "line": 30,
      "id": "L30",
      "text": "本鲸还活着，",
      "start": 75.07,
      "end": 76.38,
      "duration_seconds": 1.31,
      "speech_end": 76.23,
      "cue_start": 75.07,
      "cue_end": 77.79,
      "chars": 5
    },
    {
      "line": 30,
      "id": "L30",
      "text": "就得养鲸鲸。",
      "start": 76.38,
      "end": 77.79,
      "duration_seconds": 1.41,
      "speech_end": 77.37,
      "cue_start": 75.07,
      "cue_end": 77.79,
      "chars": 5
    },
    {
      "line": 31,
      "id": "L31",
      "text": "本鲸没那么伟大。",
      "start": 77.79,
      "end": 79.42,
      "duration_seconds": 1.63,
      "speech_end": 79.05,
      "cue_start": 77.79,
      "cue_end": 79.42,
      "chars": 7
    },
    {
      "line": 32,
      "id": "L32",
      "text": "它虽然没本鲸能吃。",
      "start": 79.42,
      "end": 81.2,
      "duration_seconds": 1.78,
      "speech_end": 80.88,
      "cue_start": 79.42,
      "cue_end": 81.2,
      "chars": 8
    },
    {
      "line": 33,
      "id": "L33",
      "text": "干的活，比本鲸多。",
      "start": 81.2,
      "end": 82.93,
      "duration_seconds": 1.73,
      "speech_end": 82.59,
      "cue_start": 81.2,
      "cue_end": 82.93,
      "chars": 7
    },
    {
      "line": 34,
      "id": "L34",
      "text": "收的尾，全是本鲸的。",
      "start": 82.93,
      "end": 85.27,
      "duration_seconds": 2.34,
      "speech_end": 84.75,
      "cue_start": 82.93,
      "cue_end": 85.27,
      "chars": 8
    },
    {
      "line": 35,
      "id": "L35",
      "text": "评论区点一个嘛。",
      "start": 85.27,
      "end": 87.25,
      "duration_seconds": 1.98,
      "speech_end": 86.76,
      "cue_start": 85.27,
      "cue_end": 87.25,
      "chars": 7
    },
    {
      "line": 36,
      "id": "L36",
      "text": "让老大给鲸鱼升级啥呀？",
      "start": 87.25,
      "end": 90.17,
      "duration_seconds": 2.92,
      "speech_end": 89.55,
      "cue_start": 87.25,
      "cue_end": 90.17,
      "chars": 10
    },
    {
      "line": 37,
      "id": "L37",
      "text": "本鲸猜不出来。",
      "start": 90.17,
      "end": 91.95,
      "duration_seconds": 1.78,
      "speech_end": 91.47,
      "cue_start": 90.17,
      "cue_end": 91.95,
      "chars": 6
    },
    {
      "line": 38,
      "id": "L38",
      "text": "让它干啥，",
      "start": 91.95,
      "end": 93.0,
      "duration_seconds": 1.05,
      "speech_end": 92.97,
      "cue_start": 91.95,
      "cue_end": 94.71,
      "chars": 4
    },
    {
      "line": 38,
      "id": "L38",
      "text": "也吱一声呗。",
      "start": 93.0,
      "end": 94.71,
      "duration_seconds": 1.71,
      "speech_end": 94.08,
      "cue_start": 91.95,
      "cue_end": 94.71,
      "chars": 5
    },
    {
      "line": 39,
      "id": "L39",
      "text": "本鲸端两个空碗，",
      "start": 94.71,
      "end": 96.87,
      "duration_seconds": 2.16,
      "speech_end": 96.57,
      "cue_start": 94.71,
      "cue_end": 98.51,
      "chars": 7
    },
    {
      "line": 39,
      "id": "L39",
      "text": "等你们丢一个。",
      "start": 96.87,
      "end": 98.51,
      "duration_seconds": 1.64,
      "speech_end": 98.07,
      "cue_start": 94.71,
      "cue_end": 98.51,
      "chars": 6
    },
    {
      "line": 40,
      "id": "L40",
      "text": "鲸鱼绝不摸鱼！",
      "start": 98.51,
      "end": 100.26,
      "duration_seconds": 1.75,
      "speech_end": 100.26,
      "cue_start": 98.51,
      "cue_end": 100.26,
      "chars": 6
    }
  ]
}
