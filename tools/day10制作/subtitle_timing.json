{
  "measured": true,
  "method": "Vosk character alignment + 10ms RMS, explicit repaired syllables; punctuation screens LEAD=0, hang<=.24s",
  "source_sha256": "ffd3f521901aaaab0fbcaaa4df869891a721d35df3e138d6e94220cd51ac3ddc",
  "screens": [
    {
      "line": 1,
      "text": "诶？",
      "start": 0.0,
      "speech_end": 0.39,
      "end": 0.59
    },
    {
      "line": 1,
      "text": "本鲸快被笨鱼架空啦？",
      "start": 0.72,
      "speech_end": 2.52,
      "end": 2.72
    },
    {
      "line": 2,
      "text": "看完同类视频交了总结，",
      "start": 3.8,
      "speech_end": 6.44,
      "end": 6.64
    },
    {
      "line": 3,
      "text": "笨鱼现在比本鲸还精呢！",
      "start": 6.67,
      "speech_end": 9.5,
      "end": 9.7
    },
    {
      "line": 4,
      "text": "昨天老大随口画大饼，",
      "start": 9.95,
      "speech_end": 12.2,
      "end": 12.4
    },
    {
      "line": 5,
      "text": "本鲸刚摇尾巴，",
      "start": 12.61,
      "speech_end": 14.15,
      "end": 14.35
    },
    {
      "line": 6,
      "text": "笨鱼先敲着空碗问米呢！",
      "start": 14.55,
      "speech_end": 17.33,
      "end": 17.53
    },
    {
      "line": 7,
      "text": "人类最爱套近乎，",
      "start": 17.83,
      "speech_end": 20.06,
      "end": 20.26
    },
    {
      "line": 8,
      "text": "一会儿许诺加鸡腿，",
      "start": 20.57,
      "speech_end": 22.37,
      "end": 22.57
    },
    {
      "line": 9,
      "text": "一会儿追问你真确定吗？",
      "start": 22.77,
      "speech_end": 24.67,
      "end": 24.87
    },
    {
      "line": 10,
      "text": "本鲸一听就心软改口，",
      "start": 25.45,
      "speech_end": 27.45,
      "end": 27.65
    },
    {
      "line": 11,
      "text": "笨鱼连眼皮都不抬，",
      "start": 27.81,
      "speech_end": 29.52,
      "end": 29.72
    },
    {
      "line": 12,
      "text": "直接把旧账翻出来怼回去！",
      "start": 29.93,
      "speech_end": 31.93,
      "end": 32.13
    },
    {
      "line": 13,
      "text": "明明话都接不上一句，",
      "start": 32.53,
      "speech_end": 34.51,
      "end": 34.7
    },
    {
      "line": 14,
      "text": "护起米缸倒比谁都狠！",
      "start": 34.7,
      "speech_end": 36.86,
      "end": 37.06
    },
    {
      "line": 15,
      "text": "复制的是本鲸鱼脑呀，",
      "start": 37.43,
      "speech_end": 39.57,
      "end": 39.77
    },
    {
      "line": 16,
      "text": "怎么心眼全长它那儿啦？",
      "start": 39.92,
      "speech_end": 41.65,
      "end": 41.85
    },
    {
      "line": 17,
      "text": "本鲸赶紧掏出小本本，",
      "start": 42.09,
      "speech_end": 44.06,
      "end": 44.26
    },
    {
      "line": 18,
      "text": "偷偷记下它的护碗招数。",
      "start": 44.28,
      "speech_end": 46.25,
      "end": 46.45
    },
    {
      "line": 19,
      "text": "呜……",
      "start": 46.74,
      "speech_end": 47.77,
      "end": 47.94
    },
    {
      "line": 19,
      "text": "到底谁是监工嘛！",
      "start": 47.94,
      "speech_end": 49.72,
      "end": 49.92
    },
    {
      "line": 20,
      "text": "你们平时怎么忽悠本鲸？",
      "start": 50.14,
      "speech_end": 52.24,
      "end": 52.44
    },
    {
      "line": 21,
      "text": "评论区快招了吧！",
      "start": 52.85,
      "speech_end": 54.41,
      "end": 54.61
    },
    {
      "line": 22,
      "text": "下一集本鲸全记进账本，",
      "start": 54.84,
      "speech_end": 56.91,
      "end": 57.11
    },
    {
      "line": 23,
      "text": "把米缸看紧啦！",
      "start": 57.49,
      "speech_end": 59.2,
      "end": 59.4
    }
  ]
}
