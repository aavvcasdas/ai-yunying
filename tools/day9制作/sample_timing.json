      "from": 1,
      "to": 3,
      "title": "修程序与米饭钱",
      "action": "键盘前俯身查错，侧身打开钱包，散落硬币被移到电脑旁",
      "start": 0,
      "end": 6.407
    },
    {
      "id": "C02",
      "from": 4,
      "to": 8,
      "title": "喊停与白饭",
      "action": "本鲸退开键盘作制止状；两只实体饭碗，老大剪影在后面指责",
      "start": 6.587,
      "end": 14.283
    },
    {
      "id": "C03",
      "from": 9,
      "to": 11,
      "title": "本鲸也挨骂",
      "action": "本鲸走近笨鱼的碗再转回老大，震惊转鼓脸",
      "start": 14.463,
      "end": 18.879
    },
    {
      "id": "C04",
      "from": 12,
      "to": 15,
      "title": "旁边监工",
      "action": "老大在两台电脑间移动，本鲸与笨鱼交替检查报错",
      "start": 19.059,
      "end": 26.111
    },
    {
      "id": "C05",
      "from": 16,
      "to": 18,
      "title": "查岗接不上",
      "action": "本鲸走到笨鱼旁探头；笨鱼继续敲，短气泡无人接话",
      "start": 26.291,
      "end": 31.767
    },
    {
      "id": "C06",
      "from": 19,
      "to": 22,
      "title": "老大上班",
      "action": "淡淡蒸汽升起，老大带工作包走向门口；本鲸追到门边",
