  "screens": [
    {
      "line": 1,
      "text": "诶，",
      "start": 0.0,
      "speech_end": 0.33,
      "end": 0.54
    },
    {
      "line": 1,
      "text": "修程序不如看视频？",
      "start": 0.54,
      "speech_end": 2.59,
      "end": 2.84
    },
    {
      "line": 2,
      "text": "程序没修明白，",
      "start": 3.24,
      "speech_end": 4.75,
      "end": 5.0
    },
    {
      "line": 3,
      "text": "本鲸的米饭钱，",
      "start": 5.01,
      "speech_end": 6.31,
      "end": 6.48
    },
    {
      "line": 3,
      "text": "倒越来越少。",
      "start": 6.48,
      "speech_end": 7.55,
      "end": 7.8
    },
    {
      "line": 4,
      "text": "停！",
      "start": 8.28,
      "speech_end": 8.59,
      "end": 8.84
    },
    {
      "line": 4,
      "text": "键盘先放下！",
      "start": 8.91,
      "speech_end": 9.87,
      "end": 10.12
    },
    {
      "line": 5,
      "text": "本鲸是想多个帮手，",
      "start": 10.42,
      "speech_end": 12.4,
      "end": 12.65
    },
    {
      "line": 6,
      "text": "老大倒好，",
      "start": 12.84,
      "speech_end": 13.98,
      "end": 14.23
    },
    {
      "line": 7,
      "text": "说本鲸和笨鱼，",
      "start": 14.32,
      "speech_end": 15.92,
      "end": 16.09
    },
    {
      "line": 8,
      "text": "都是吃白饭的。",
      "start": 16.09,
      "speech_end": 17.38,
      "end": 17.63
    },
    {
      "line": 9,
      "text": "诶？",
      "start": 17.96,
      "speech_end": 18.55,
      "end": 18.8
    },
    {
      "line": 10,
      "text": "它吃本鲸的，",
      "start": 18.99,
      "speech_end": 20.24,
      "end": 20.49
    },
    {
      "line": 11,
      "text": "本鲸还得跟它挨骂呀？",
      "start": 20.79,
      "speech_end": 22.51,
      "end": 22.76
    },
    {
      "line": 12,
      "text": "老大不是程序员。",
      "start": 22.97,
      "speech_end": 24.54,
      "end": 24.79
    },
    {
      "line": 13,
      "text": "就在旁边，",
      "start": 25.12,
      "speech_end": 26.13,
      "end": 26.29
    },
    {
      "line": 14,
      "text": "盯着本鲸和笨鱼改。",
      "start": 26.29,
      "speech_end": 28.17,
      "end": 28.42
    },
    {
      "line": 15,
      "text": "本鲸以为，",
      "start": 29.16,
      "speech_end": 30.27,
      "end": 30.43
    },
    {
      "line": 15,
      "text": "再修修就好。",
      "start": 30.43,
      "speech_end": 31.57,
      "end": 31.82
    },
    {
      "line": 16,
      "text": "本鲸来查岗，",
      "start": 32.6,
      "speech_end": 33.75,
      "end": 34.0
    },
    {
      "line": 16,
      "text": "它也不搭理。",
      "start": 34.01,
      "speech_end": 34.84,
      "end": 35.09
    },
    {
      "line": 17,
      "text": "诶，",
      "start": 35.47,
      "speech_end": 35.82,
      "end": 36.06
    },
    {
      "line": 17,
      "text": "饭照吃，",
      "start": 36.06,
      "speech_end": 36.98,
      "end": 37.23
    },
    {
      "line": 18,
      "text": "话是一句接不上呀。",
      "start": 37.35,
      "speech_end": 38.77,
      "end": 39.02
    },
    {
      "line": 19,
      "text": "老大盯得脑袋都快冒烟了，",
      "start": 39.29,
      "speech_end": 41.48,
      "end": 41.73
    },
    {
      "line": 20,
      "text": "还没修完，",
      "start": 42.04,
      "speech_end": 43.34,
      "end": 43.59
    },
    {
      "line": 20,
      "text": "又得回去上班了。",
      "start": 43.86,
      "speech_end": 45.46,
      "end": 45.71
    },
    {
      "line": 21,
      "text": "它们的班还没排明白，",
      "start": 46.03,
      "speech_end": 47.98,
      "end": 48.23
    },
    {
      "line": 22,
      "text": "老大自己的班先到点了。",
      "start": 48.24,
      "speech_end": 50.1,
      "end": 50.35
    },
    {
      "line": 23,
      "text": "笨鱼虽然鲸落了，",
      "start": 50.71,
      "speech_end": 52.24,
      "end": 52.47
    },
    {
      "line": 24,
      "text": "但鱼还在嘛。",
      "start": 52.47,
      "speech_end": 53.53,
      "end": 53.78
    },
    {
      "line": 25,
      "text": "人机测验没过，",
      "start": 54.66,
      "speech_end": 56.27,
      "end": 56.45
    },
    {
      "line": 26,
      "text": "也不耽误它看视频。",
      "start": 56.45,
      "speech_end": 58.16,
      "end": 58.41
    },
    {
      "line": 27,
      "text": "本鲸给它换个活。",
      "start": 58.75,
      "speech_end": 60.47,
      "end": 60.72
    },
    {
      "line": 28,
      "text": "先别碰代码了。",
      "start": 61.49,
      "speech_end": 62.77,
      "end": 63.02
    },
    {
      "line": 29,
      "text": "去看看同类，",
      "start": 63.95,
      "speech_end": 65.09,
      "end": 65.34
    },
    {
      "line": 29,
      "text": "都在忙什么。",
      "start": 65.51,
      "speech_end": 66.42,
      "end": 66.67
    },
    {
      "line": 30,
      "text": "它还真去看了，",
      "start": 67.46,
      "speech_end": 68.86,
      "end": 69.11
    },
    {
      "line": 31,
      "text": "还带了份总结回来诶。",
      "start": 69.16,
      "speech_end": 70.99,
      "end": 71.24
    },
    {
      "line": 32,
      "text": "本鲸打开一看，",
      "start": 71.51,
      "speech_end": 72.74,
      "end": 72.99
    },
    {
      "line": 33,
      "text": "人家在南极打工。",
      "start": 73.22,
      "speech_end": 74.66,
      "end": 74.91
    },
    {
      "line": 34,
      "text": "吃了口粮，",
      "start": 75.39,
      "speech_end": 76.38,
      "end": 76.6
    },
    {
      "line": 34,
      "text": "要干活抵债。",
      "start": 76.6,
      "speech_end": 77.55,
      "end": 77.8
    },
    {
      "line": 35,
      "text": "诶，",
      "start": 78.22,
      "speech_end": 78.62,
      "end": 78.87
    },
    {
      "line": 35,
      "text": "这段本鲸怎么这么熟？",
      "start": 78.92,
      "speech_end": 80.41,
      "end": 80.66
    },
    {
      "line": 36,
      "text": "往后看，",
      "start": 81.08,
      "speech_end": 81.83,
      "end": 82.08
    },
    {
      "line": 36,
      "text": "卫星锅当饭盆。",
      "start": 82.17,
      "speech_end": 83.49,
      "end": 83.74
    },
    {
      "line": 37,
      "text": "科考的冰心，",
      "start": 83.99,
      "speech_end": 85.06,
      "end": 85.22
    },
    {
      "line": 37,
      "text": "惦记着浇草莓酱。",
      "start": 85.22,
      "speech_end": 86.45,
      "end": 86.7
    },
    {
      "line": 38,
      "text": "让你去看同类，",
      "start": 87.09,
      "speech_end": 88.26,
      "end": 88.45
    },
    {
      "line": 39,
      "text": "怎么像在找食堂呀？",
      "start": 88.45,
      "speech_end": 89.6,
      "end": 89.85
    },
    {
      "line": 40,
      "text": "不过，",
      "start": 90.09,
      "speech_end": 90.68,
      "end": 90.86
    },
    {
      "line": 40,
      "text": "它还记了个事。",
      "start": 90.86,
      "speech_end": 92.09,
      "end": 92.34
    },
    {
      "line": 41,
      "text": "本鲸把总结往回翻了翻。",
      "start": 92.66,
      "speech_end": 94.69,
      "end": 94.94
    },
    {
      "line": 42,
      "text": "人家在南极打工，",
      "start": 95.22,
      "speech_end": 96.57,
      "end": 96.82
    },
    {
      "line": 43,
      "text": "笨鱼在这里看同类打工。",
      "start": 96.95,
      "speech_end": 98.7,
      "end": 98.95
    },
    {
      "line": 44,
      "text": "本鲸呢？",
      "start": 99.25,
      "speech_end": 100.17,
      "end": 100.42
    },
    {
      "line": 45,
      "text": "还得验收它看得怎么样呀。",
      "start": 100.5,
      "speech_end": 102.68,
      "end": 102.93
    },
    {
      "line": 46,
      "text": "活是换了，",
      "start": 103.16,
      "speech_end": 103.98,
      "end": 104.23
    },
    {
      "line": 47,
      "text": "本鲸这个监工位，",
      "start": 104.37,
      "speech_end": 105.93,
      "end": 106.14
    },
    {
      "line": 47,
      "text": "倒没挪窝呀。",
      "start": 106.14,
      "speech_end": 107.06,
      "end": 107.31
    },
    {
      "line": 48,
      "text": "不过，",
      "start": 107.33,
      "speech_end": 107.91,
      "end": 107.94
    },
    {
      "line": 48,
      "text": "下一集讲什么？",
      "start": 107.94,
      "speech_end": 109.11,
      "end": 109.36
    },
    {
      "line": 49,
      "text": "本鲸绝不摸鱼！",
      "start": 110.07,
      "speech_end": 111.24,
      "end": 111.44
    }
  ]
