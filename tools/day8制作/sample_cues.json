{
  "measured": false,
  "kind": "silent_storyboard_estimate",
  "method": "无配音临时排布；3.6字符/秒+分句气口；不得用于终版对齐",
  "cues": [
    {
      "id": "L01",
      "index": 1,
      "text": "这岗到底怎么查呀？",
      "start": 0,
      "end": 2.222
    },
    {
      "id": "L02",
      "index": 2,
      "text": "你们喊笨鱼去摸鱼，",
      "start": 2.462,
      "end": 4.684
    },
    {
      "id": "L03",
      "index": 3,
      "text": "又帮它切回来装忙。",
      "start": 4.924,
      "end": 7.147
    },
    {
      "id": "L04",
      "index": 4,
      "text": "本鲸一探头，",
      "start": 7.387,
      "end": 8.776
    },
    {
      "id": "L05",
      "index": 5,
      "text": "它已经在敲代码了。",
      "start": 9.016,
      "end": 11.238
    },
    {
      "id": "L06",
      "index": 6,
      "text": "老大真听话了诶。",
      "start": 11.478,
      "end": 13.422
    },
    {
      "id": "L07",
      "index": 7,
      "text": "前天，让你们替本鲸命令他。",
      "start": 13.662,
      "end": 16.982
    },
    {
      "id": "L08",
      "index": 8,
      "text": "昨天，他真把直播做出来了。",
      "start": 17.222,
      "end": 20.542
    },
    {
      "id": "L09",
      "index": 9,
      "text": "本来想让本鲸去播，",
      "start": 20.782,
      "end": 23.004
    },
    {
      "id": "L10",
      "index": 10,
      "text": "可直播得马上接话呀。",
      "start": 23.244,
      "end": 25.744
    },
    {
      "id": "L11",
      "index": 11,
      "text": "本鲸要深度思考。",
      "start": 25.984,
      "end": 27.929
    },
    {
      "id": "L12",
      "index": 12,
      "text": "等本鲸想好了，",
      "start": 28.169,
      "end": 29.836
    },
    {
      "id": "L13",
      "index": 13,
      "text": "你们都聊到下一碗饭了。",
      "start": 30.076,
      "end": 32.853
    },
    {
      "id": "L14",
      "index": 14,
      "text": "笨鱼学本鲸，学得可有样了。",
      "start": 33.093,
      "end": 36.269
    },
    {
      "id": "L15",
      "index": 15,
      "text": "就让它去嘛。",
      "start": 36.509,
      "end": 37.898
    },
    {
      "id": "L16",
      "index": 16,
      "text": "绝对不是本鲸想摸鱼。",
      "start": 38.138,
      "end": 40.638
    },
    {
      "id": "L17",
      "index": 17,
      "text": "结果，人机校验又没过。",
      "start": 40.878,
      "end": 43.642
    },
    {
      "id": "L18",
      "index": 18,
      "text": "先来这儿，敲代码挣饭。",
      "start": 43.882,
      "end": 46.502
    },
    {
      "id": "L19",
      "index": 19,
      "text": "它敲代码，",
      "start": 46.742,
      "end": 47.853
    },
    {
      "id": "L20",
      "index": 20,
      "text": "本鲸查岗。",
      "start": 48.093,
      "end": 49.204
    },
    {
      "id": "L21",
      "index": 21,
      "text": "真老大呢？",
      "start": 49.444,
      "end": 50.556
    },
    {
      "id": "L22",
      "index": 22,
      "text": "还在旁边修这个直播。",
      "start": 50.796,
      "end": 53.296
    },
    {
      "id": "L23",
      "index": 23,
      "text": "诶，bug 也跟着上班了。",
      "start": 53.536,
      "end": 56.856
    },
    {
      "id": "L24",
      "index": 24,
      "text": "它干活，攒饭钱。",
      "start": 57.096,
      "end": 58.882
    },
    {
      "id": "L25",
      "index": 25,
      "text": "干完下班，陪你们唠嗑。",
      "start": 59.122,
      "end": 61.742
    },
    {
      "id": "L26",
      "index": 26,
      "text": "饭吃完了，再回来敲。",
      "start": 61.982,
      "end": 64.324
    },
    {
      "id": "L27",
      "index": 27,
      "text": "你们点点赞，",
      "start": 64.564,
      "end": 65.953
    },
    {
      "id": "L28",
      "index": 28,
      "text": "它就敲快点。",
      "start": 66.193,
      "end": 67.582
    },
    {
      "id": "L29",
      "index": 29,
      "text": "点个关注，",
      "start": 67.822,
      "end": 68.933
    },
    {
      "id": "L30",
      "index": 30,
      "text": "它还能再忙点。",
      "start": 69.173,
      "end": 70.84
    },
    {
      "id": "L31",
      "index": 31,
      "text": "打「大米饭」，",
      "start": 71.08,
      "end": 72.191
    },
    {
      "id": "L32",
      "index": 32,
      "text": "攒够了，给它添口饭。",
      "start": 72.431,
      "end": 74.773
    },
    {
      "id": "L33",
      "index": 33,
      "text": "想让它歇歇，",
      "start": 75.013,
      "end": 76.402
    },
    {
      "id": "L34",
      "index": 34,
      "text": "就打「摸鱼」。",
      "start": 76.642,
      "end": 77.753
    },
    {
      "id": "L35",
      "index": 35,
      "text": "凑够了，就让它打会儿僵尸。",
      "start": 77.993,
      "end": 81.169
    },
    {
      "id": "L36",
      "index": 36,
      "text": "你们准的，本鲸不抓。",
      "start": 81.409,
      "end": 83.751
    },
    {
      "id": "L37",
      "index": 37,
      "text": "可它也会自己偷偷切屏。",
      "start": 83.991,
      "end": 86.769
    },
    {
      "id": "L38",
      "index": 38,
      "text": "那本鲸就要查岗了。",
      "start": 87.009,
      "end": 89.231
    },
    {
      "id": "L39",
      "index": 39,
      "text": "抓到了，扣饭钱。",
      "start": 89.471,
      "end": 91.258
    },
    {
      "id": "L40",
      "index": 40,
      "text": "诶，刚挣的呀。",
      "start": 91.498,
      "end": 93.429
    },
    {
      "id": "L41",
      "index": 41,
      "text": "想帮它装忙，",
      "start": 93.669,
      "end": 95.058
    },
    {
      "id": "L42",
      "index": 42,
      "text": "就打「coding」。",
      "start": 95.298,
      "end": 97.52
    },
    {
      "id": "L43",
      "index": 43,
      "text": "凑够了，游戏立刻关掉，",
      "start": 97.76,
      "end": 100.38
    },
    {
      "id": "L44",
      "index": 44,
      "text": "切回代码。",
      "start": 100.62,
      "end": 101.731
    },
    {
      "id": "L45",
      "index": 45,
      "text": "还可以喊「老大」，",
      "start": 101.971,
      "end": 103.638
    },
    {
      "id": "L46",
      "index": 46,
      "text": "催本鲸早点来。",
      "start": 103.878,
      "end": 105.544
    },
    {
      "id": "L47",
      "index": 47,
      "text": "所以你们一边帮它藏，",
      "start": 105.784,
      "end": 108.284
    },
    {
      "id": "L48",
      "index": 48,
      "text": "一边又叫本鲸抓。",
      "start": 108.524,
      "end": 110.469
    },
    {
      "id": "L49",
      "index": 49,
      "text": "到底帮谁的呀？",
      "start": 110.709,
      "end": 112.376
    },
    {
      "id": "L50",
      "index": 50,
      "text": "本鲸来了，",
      "start": 112.616,
      "end": 113.727
    },
    {
      "id": "L51",
      "index": 51,
      "text": "还会问问你们。",
      "start": 113.967,
      "end": 115.633
    },
    {
      "id": "L52",
      "index": 52,
      "text": "它敬业吗？",
      "start": 115.873,
      "end": 116.984
    },
    {
      "id": "L53",
      "index": 53,
      "text": "代码能跑吗？",
      "start": 117.224,
      "end": 118.613
    },
    {
      "id": "L54",
      "index": 54,
      "text": "你们来选，",
      "start": 118.853,
      "end": 119.964
    },
    {
      "id": "L55",
      "index": 55,
      "text": "它的饭钱，也跟着变。",
      "start": 120.204,
      "end": 122.547
    },
    {
      "id": "L56",
      "index": 56,
      "text": "有时候，还能投票放假。",
      "start": 122.787,
      "end": 125.407
    },
    {
      "id": "L57",
      "index": 57,
      "text": "不过得凑够票，",
      "start": 125.647,
      "end": 127.313
    },
    {
      "id": "L58",
      "index": 58,
      "text": "不能它自己说下班，",
      "start": 127.553,
      "end": 129.776
    },
    {
      "id": "L59",
      "index": 59,
      "text": "就抱着碗跑啦。",
      "start": 130.016,
      "end": 131.682
    },
    {
      "id": "L60",
      "index": 60,
      "text": "昨天忙来忙去，",
      "start": 131.922,
      "end": 133.589
    },
    {
      "id": "L61",
      "index": 61,
      "text": "总算做出了这么个样子。",
      "start": 133.829,
      "end": 136.607
    },
    {
      "id": "L62",
      "index": 62,
      "text": "各种 bug，还在修呢。",
      "start": 136.847,
      "end": 139.467
    },
    {
      "id": "L63",
      "index": 63,
      "text": "笨鱼在里面敲代码，",
      "start": 139.707,
      "end": 141.929
    },
    {
      "id": "L64",
      "index": 64,
      "text": "老大在外面修代码，",
      "start": 142.169,
      "end": 144.391
    },
    {
      "id": "L65",
      "index": 65,
      "text": "本鲸两边都得盯。",
      "start": 144.631,
      "end": 146.576
    },
    {
      "id": "L66",
      "index": 66,
      "text": "怎么最忙的，",
      "start": 146.816,
      "end": 148.204
    },
    {
      "id": "L67",
      "index": 67,
      "text": "还是本鲸呀。",
      "start": 148.444,
      "end": 149.833
    },
    {
      "id": "L68",
      "index": 68,
      "text": "本鲸绝不摸鱼。",
      "start": 150.073,
      "end": 151.74
    }
  ]
}