{
  "measured": true,
  "method": "ASR逐字识别+RMS气口修边；英文coding/bug按所在实测发声段整体保留；LEAD=0；最大尾挂0.25s",
  "screens": [
    {
      "id": "L01",
      "text": "这岗到底怎么查呀？",
      "start": 0.0,
      "speech_end": 1.71,
      "end": 1.96
    },
    {
      "id": "L02",
      "text": "你们喊笨鱼去摸鱼，",
      "start": 2.43,
      "speech_end": 4.21,
      "end": 4.46
    },
    {
      "id": "L03",
      "text": "又帮它切回来装忙。",
      "start": 4.58,
      "speech_end": 6.33,
      "end": 6.58
    },
    {
      "id": "L04",
      "text": "本鲸一探头，",
      "start": 7.01,
      "speech_end": 8.25,
      "end": 8.5
    },
    {
      "id": "L05",
      "text": "它已经在敲代码了。",
      "start": 8.52,
      "speech_end": 10.05,
      "end": 10.3
    },
    {
      "id": "L06",
      "text": "老大真听话了诶。",
      "start": 11.07,
      "speech_end": 12.66,
      "end": 12.91
    },
    {
      "id": "L07",
      "text": "前天，",
      "start": 13.2,
      "speech_end": 13.7,
      "end": 13.95
    },
    {
      "id": "L07",
      "text": "让你们替本鲸命令他。",
      "start": 14.02,
      "speech_end": 15.62,
      "end": 15.87
    },
    {
      "id": "L08",
      "text": "昨天，",
      "start": 16.19,
      "speech_end": 16.83,
      "end": 16.99
    },
    {
      "id": "L08",
      "text": "他真把直播做出来了。",
      "start": 16.99,
      "speech_end": 18.46,
      "end": 18.71
    },
    {
      "id": "L09",
      "text": "本来想让本鲸去播，",
      "start": 19.22,
      "speech_end": 20.81,
      "end": 21.06
    },
    {
      "id": "L10",
      "text": "可直播得马上接话呀。",
      "start": 21.1,
      "speech_end": 22.81,
      "end": 23.06
    },
    {
      "id": "L11",
      "text": "本鲸要深度思考。",
      "start": 23.4,
      "speech_end": 25.14,
      "end": 25.39
    },
    {
      "id": "L12",
      "text": "等本鲸想好了，",
      "start": 25.75,
      "speech_end": 27.18,
      "end": 27.42
    },
    {
      "id": "L13",
      "text": "你们都聊到下一碗饭了。",
      "start": 27.42,
      "speech_end": 29.01,
      "end": 29.26
    },
    {
      "id": "L14",
      "text": "笨鱼学本鲸，",
      "start": 29.52,
      "speech_end": 30.75,
      "end": 30.873
    },
    {
      "id": "L14",
      "text": "学得可有样了。",
      "start": 30.873,
      "speech_end": 31.93,
      "end": 32.18
    },
    {
      "id": "L15",
      "text": "就让它去嘛。",
      "start": 33.25,
      "speech_end": 34.18,
      "end": 34.43
    },
    {
      "id": "L16",
      "text": "绝对不是本鲸想摸鱼。",
      "start": 35.45,
      "speech_end": 37.61,
      "end": 37.86
    },
    {
      "id": "L17",
      "text": "结果，",
      "start": 38.37,
      "speech_end": 39.25,
      "end": 39.44
    },
    {
      "id": "L17",
      "text": "人机校验又没过。",
      "start": 39.44,
      "speech_end": 41.08,
      "end": 41.33
    },
    {
      "id": "L18",
      "text": "先来这儿，",
      "start": 41.8,
      "speech_end": 42.57,
      "end": 42.82
    },
    {
      "id": "L18",
      "text": "敲代码挣饭。",
      "start": 43.01,
      "speech_end": 44.12,
      "end": 44.37
    },
    {
      "id": "L19",
      "text": "它敲代码，",
      "start": 44.63,
      "speech_end": 45.81,
      "end": 46.06
    },
    {
      "id": "L20",
      "text": "本鲸查岗。",
      "start": 46.09,
      "speech_end": 47.26,
      "end": 47.51
    },
    {
      "id": "L21",
      "text": "真老大呢？",
      "start": 47.77,
      "speech_end": 48.78,
      "end": 49.03
    },
    {
      "id": "L22",
      "text": "还在旁边修这个直播。",
      "start": 49.26,
      "speech_end": 51.3,
      "end": 51.55
    },
    {
      "id": "L23",
      "text": "诶，",
      "start": 51.94,
      "speech_end": 52.37,
      "end": 52.62
    },
    {
      "id": "L23",
      "text": "bug 也跟着上班了。",
      "start": 52.72,
      "speech_end": 54.19,
      "end": 54.44
    },
    {
      "id": "L24",
      "text": "它干活，",
      "start": 55.08,
      "speech_end": 56.01,
      "end": 56.13
    },
    {
      "id": "L24",
      "text": "攒饭钱。",
      "start": 56.13,
      "speech_end": 56.99,
      "end": 57.24
    },
    {
      "id": "L25",
      "text": "干完下班，",
      "start": 57.67,
      "speech_end": 58.83,
      "end": 59.01
    },
    {
      "id": "L25",
      "text": "陪你们唠嗑。",
      "start": 59.01,
      "speech_end": 60.13,
      "end": 60.38
    },
    {
      "id": "L26",
      "text": "饭吃完了，",
      "start": 60.8,
      "speech_end": 61.78,
      "end": 62.03
    },
    {
      "id": "L26",
      "text": "再回来敲。",
      "start": 62.05,
      "speech_end": 62.84,
      "end": 63.09
    },
    {
      "id": "L27",
      "text": "你们点点赞，",
      "start": 63.33,
      "speech_end": 64.53,
      "end": 64.78
    },
    {
      "id": "L28",
      "text": "它就敲快点。",
      "start": 64.92,
      "speech_end": 66.1,
      "end": 66.35
    },
    {
      "id": "L29",
      "text": "点个关注，",
      "start": 66.97,
      "speech_end": 68.32,
      "end": 68.57
    },
    {
      "id": "L30",
      "text": "它还能再忙点。",
      "start": 68.6,
      "speech_end": 69.98,
      "end": 70.23
    },
    {
      "id": "L31",
      "text": "打「大米饭」，",
      "start": 70.57,
      "speech_end": 71.63,
      "end": 71.88
    },
    {
      "id": "L32",
      "text": "攒够了，",
      "start": 72.21,
      "speech_end": 73.23,
      "end": 73.46
    },
    {
      "id": "L32",
      "text": "给它添口饭。",
      "start": 73.46,
      "speech_end": 74.68,
      "end": 74.93
    },
    {
      "id": "L33",
      "text": "想让它歇歇，",
      "start": 75.11,
      "speech_end": 76.81,
      "end": 77.06
    },
    {
      "id": "L34",
      "text": "就打「摸鱼」。",
      "start": 77.3,
      "speech_end": 78.43,
      "end": 78.68
    },
    {
      "id": "L35",
      "text": "凑够了，",
      "start": 78.94,
      "speech_end": 79.97,
      "end": 80.22
    },
    {
      "id": "L35",
      "text": "就让它打会儿僵尸。",
      "start": 80.3,
      "speech_end": 82.46,
      "end": 82.71
    },
    {
      "id": "L36",
      "text": "你们准的，",
      "start": 83.04,
      "speech_end": 83.98,
      "end": 84.2
    },
    {
      "id": "L36",
      "text": "本鲸不抓。",
      "start": 84.2,
      "speech_end": 85.07,
      "end": 85.32
    },
    {
      "id": "L37",
      "text": "可它也会自己偷偷切屏。",
      "start": 85.79,
      "speech_end": 87.81,
      "end": 88.06
    },
    {
      "id": "L38",
      "text": "那本鲸就要查岗了。",
      "start": 88.61,
      "speech_end": 90.38,
      "end": 90.63
    },
    {
      "id": "L39",
      "text": "抓到了，",
      "start": 91.14,
      "speech_end": 91.96,
      "end": 92.2
    },
    {
      "id": "L39",
      "text": "扣饭钱。",
      "start": 92.2,
      "speech_end": 93.16,
      "end": 93.41
    },
    {
      "id": "L40",
      "text": "诶，",
      "start": 93.86,
      "speech_end": 94.3,
      "end": 94.55
    },
    {
      "id": "L40",
      "text": "刚挣的呀。",
      "start": 94.58,
      "speech_end": 95.5,
      "end": 95.75
    },
    {
      "id": "L41",
      "text": "想帮它装忙，",
      "start": 96.88,
      "speech_end": 98.18,
      "end": 98.43
    },
    {
      "id": "L42",
      "text": "就打「coding」。",
      "start": 98.44,
      "speech_end": 99.48,
      "end": 99.73
    },
    {
      "id": "L43",
      "text": "凑够了，",
      "start": 100.29,
      "speech_end": 101.16,
      "end": 101.33
    },
    {
      "id": "L43",
      "text": "游戏立刻关掉，",
      "start": 101.33,
      "speech_end": 102.66,
      "end": 102.89
    },
    {
      "id": "L44",
      "text": "切回代码。",
      "start": 102.89,
      "speech_end": 103.9,
      "end": 104.15
    },
    {
      "id": "L45",
      "text": "还可以喊「老大」，",
      "start": 104.38,
      "speech_end": 105.68,
      "end": 105.86
    },
    {
      "id": "L46",
      "text": "催本鲸早点来。",
      "start": 105.86,
      "speech_end": 107.23,
      "end": 107.48
    },
    {
      "id": "L47",
      "text": "所以你们一边帮它藏，",
      "start": 107.86,
      "speech_end": 109.77,
      "end": 110.02
    },
    {
      "id": "L48",
      "text": "一边又叫本鲸抓。",
      "start": 110.09,
      "speech_end": 111.45,
      "end": 111.7
    },
    {
      "id": "L49",
      "text": "到底帮谁的呀？",
      "start": 111.94,
      "speech_end": 113.02,
      "end": 113.27
    },
    {
      "id": "L50",
      "text": "本鲸来了，",
      "start": 114.37,
      "speech_end": 115.2,
      "end": 115.45
    },
    {
      "id": "L51",
      "text": "还会问问你们。",
      "start": 115.45,
      "speech_end": 116.52,
      "end": 116.77
    },
    {
      "id": "L52",
      "text": "它敬业吗？",
      "start": 117.43,
      "speech_end": 118.36,
      "end": 118.61
    },
    {
      "id": "L53",
      "text": "代码能跑吗？",
      "start": 118.87,
      "speech_end": 120.01,
      "end": 120.26
    },
    {
      "id": "L54",
      "text": "你们来选，",
      "start": 120.56,
      "speech_end": 121.39,
      "end": 121.64
    },
    {
      "id": "L55",
      "text": "它的饭钱，",
      "start": 121.86,
      "speech_end": 122.82,
      "end": 122.97
    },
    {
      "id": "L55",
      "text": "也跟着变。",
      "start": 122.97,
      "speech_end": 123.94,
      "end": 124.19
    },
    {
      "id": "L56",
      "text": "有时候，",
      "start": 124.79,
      "speech_end": 125.55,
      "end": 125.76
    },
    {
      "id": "L56",
      "text": "还能投票放假。",
      "start": 125.76,
      "speech_end": 127.27,
      "end": 127.52
    },
    {
      "id": "L57",
      "text": "不过得凑够票，",
      "start": 127.87,
      "speech_end": 129.01,
      "end": 129.26
    },
    {
      "id": "L58",
      "text": "不能它自己说下班，",
      "start": 129.64,
      "speech_end": 131.39,
      "end": 131.63
    },
    {
      "id": "L59",
      "text": "就抱着碗跑啦。",
      "start": 131.63,
      "speech_end": 132.94,
      "end": 133.19
    },
    {
      "id": "L60",
      "text": "昨天忙来忙去，",
      "start": 134.44,
      "speech_end": 136.0,
      "end": 136.25
    },
    {
      "id": "L61",
      "text": "总算做出了这么个样子。",
      "start": 136.32,
      "speech_end": 138.22,
      "end": 138.47
    },
    {
      "id": "L62",
      "text": "各种 bug，",
      "start": 138.92,
      "speech_end": 139.89,
      "end": 140.14
    },
    {
      "id": "L62",
      "text": "还在修呢。",
      "start": 140.27,
      "speech_end": 141.16,
      "end": 141.41
    },
    {
      "id": "L63",
      "text": "笨鱼在里面敲代码，",
      "start": 141.62,
      "speech_end": 143.18,
      "end": 143.36
    },
    {
      "id": "L64",
      "text": "老大在外面修代码，",
      "start": 143.36,
      "speech_end": 144.88,
      "end": 145.13
    },
    {
      "id": "L65",
      "text": "本鲸两边都得盯。",
      "start": 145.21,
      "speech_end": 149.01,
      "end": 146.73
    },
    {
      "id": "L66",
      "text": "怎么最忙的，",
      "start": 146.73,
      "speech_end": 147.915,
      "end": 147.915
    },
    {
      "id": "L67",
      "text": "还是本鲸呀。",
      "start": 147.915,
      "speech_end": 149.5,
      "end": 149.5
    },
    {
      "id": "L68",
      "text": "本鲸绝不摸鱼。",
      "start": 149.5,
      "speech_end": 150.63,
      "end": 150.83
    }
  ]
}