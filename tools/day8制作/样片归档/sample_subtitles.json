{
  "measured": false,
  "screens": [
    {
      "id": "L01",
      "text": "这岗到底怎么查呀？",
      "start": 0,
      "end": 2.222,
      "speech_end": 2.222
    },
    {
      "id": "L02",
      "text": "你们喊笨鱼去摸鱼，",
      "start": 2.462,
      "end": 4.684,
      "speech_end": 4.684
    },
    {
      "id": "L03",
      "text": "又帮它切回来装忙。",
      "start": 4.924,
      "end": 7.147,
      "speech_end": 7.147
    },
    {
      "id": "L04",
      "text": "本鲸一探头，",
      "start": 7.387,
      "end": 8.776,
      "speech_end": 8.776
    },
    {
      "id": "L05",
      "text": "它已经在敲代码了。",
      "start": 9.016,
      "end": 11.238,
      "speech_end": 11.238
    },
    {
      "id": "L06",
      "text": "老大真听话了诶。",
      "start": 11.478,
      "end": 13.422,
      "speech_end": 13.422
    },
    {
      "id": "L07",
      "text": "前天，",
      "start": 13.662,
      "end": 14.362,
      "speech_end": 14.362
    },
    {
      "id": "L07",
      "text": "让你们替本鲸命令他。",
      "start": 14.482,
      "end": 16.982,
      "speech_end": 16.982
    },
    {
      "id": "L08",
      "text": "昨天，",
      "start": 17.222,
      "end": 17.922,
      "speech_end": 17.922
    },
    {
      "id": "L08",
      "text": "他真把直播做出来了。",
      "start": 18.042,
      "end": 20.542,
      "speech_end": 20.542
    },
    {
      "id": "L09",
      "text": "本来想让本鲸去播，",
      "start": 20.782,
      "end": 23.004,
      "speech_end": 23.004
    },
    {
      "id": "L10",
      "text": "可直播得马上接话呀。",
      "start": 23.244,
      "end": 25.744,
      "speech_end": 25.744
    },
    {
      "id": "L11",
      "text": "本鲸要深度思考。",
      "start": 25.984,
      "end": 27.929,
      "speech_end": 27.929
    },
    {
      "id": "L12",
      "text": "等本鲸想好了，",
      "start": 28.169,
      "end": 29.836,
      "speech_end": 29.836
    },
    {
      "id": "L13",
      "text": "你们都聊到下一碗饭了。",
      "start": 30.076,
      "end": 32.853,
      "speech_end": 32.853
    },
    {
      "id": "L14",
      "text": "笨鱼学本鲸，",
      "start": 33.093,
      "end": 34.482,
      "speech_end": 34.482
    },
    {
      "id": "L14",
      "text": "学得可有样了。",
      "start": 34.602,
      "end": 36.269,
      "speech_end": 36.269
    },
    {
      "id": "L15",
      "text": "就让它去嘛。",
      "start": 36.509,
      "end": 37.898,
      "speech_end": 37.898
    },
    {
      "id": "L16",
      "text": "绝对不是本鲸想摸鱼。",
      "start": 38.138,
      "end": 40.638,
      "speech_end": 40.638
    },
    {
      "id": "L17",
      "text": "结果，",
      "start": 40.878,
      "end": 41.578,
      "speech_end": 41.578
    },
    {
      "id": "L17",
      "text": "人机校验又没过。",
      "start": 41.698,
      "end": 43.642,
      "speech_end": 43.642
    },
    {
      "id": "L18",
      "text": "先来这儿，",
      "start": 43.882,
      "end": 44.993,
      "speech_end": 44.993
    },
    {
      "id": "L18",
      "text": "敲代码挣饭。",
      "start": 45.113,
      "end": 46.502,
      "speech_end": 46.502
    },
    {
      "id": "L19",
      "text": "它敲代码，",
      "start": 46.742,
      "end": 47.853,
      "speech_end": 47.853
    },
    {
      "id": "L20",
      "text": "本鲸查岗。",
      "start": 48.093,
      "end": 49.204,
      "speech_end": 49.204
    },
    {
      "id": "L21",
      "text": "真老大呢？",
      "start": 49.444,
      "end": 50.556,
      "speech_end": 50.556
    },
    {
      "id": "L22",
      "text": "还在旁边修这个直播。",
      "start": 50.796,
      "end": 53.296,
      "speech_end": 53.296
    },
    {
      "id": "L23",
      "text": "诶，",
      "start": 53.536,
      "end": 54.236,
      "speech_end": 54.236
    },
    {
      "id": "L23",
      "text": "bug 也跟着上班了。",
      "start": 54.356,
      "end": 56.856,
      "speech_end": 56.856
    },
    {
      "id": "L24",
      "text": "它干活，",
      "start": 57.096,
      "end": 57.929,
      "speech_end": 57.929
    },
    {
      "id": "L24",
      "text": "攒饭钱。",
      "start": 58.049,
      "end": 58.882,
      "speech_end": 58.882
    },
    {
      "id": "L25",
      "text": "干完下班，",
      "start": 59.122,
      "end": 60.233,
      "speech_end": 60.233
    },
    {
      "id": "L25",
      "text": "陪你们唠嗑。",
      "start": 60.353,
      "end": 61.742,
      "speech_end": 61.742
    },
    {
      "id": "L26",
      "text": "饭吃完了，",
      "start": 61.982,
      "end": 63.093,
      "speech_end": 63.093
    },
    {
      "id": "L26",
      "text": "再回来敲。",
      "start": 63.213,
      "end": 64.324,
      "speech_end": 64.324
    },
    {
      "id": "L27",
      "text": "你们点点赞，",
      "start": 64.564,
      "end": 65.953,
      "speech_end": 65.953
    },
    {
      "id": "L28",
      "text": "它就敲快点。",
      "start": 66.193,
      "end": 67.582,
      "speech_end": 67.582
    },
    {
      "id": "L29",
      "text": "点个关注，",
      "start": 67.822,
      "end": 68.933,
      "speech_end": 68.933
    },
    {
      "id": "L30",
      "text": "它还能再忙点。",
      "start": 69.173,
      "end": 70.84,
      "speech_end": 70.84
    },
    {
      "id": "L31",
      "text": "打「大米饭」，",
      "start": 71.08,
      "end": 72.191,
      "speech_end": 72.191
    },
    {
      "id": "L32",
      "text": "攒够了，",
      "start": 72.431,
      "end": 73.264,
      "speech_end": 73.264
    },
    {
      "id": "L32",
      "text": "给它添口饭。",
      "start": 73.384,
      "end": 74.773,
      "speech_end": 74.773
    },
    {
      "id": "L33",
      "text": "想让它歇歇，",
      "start": 75.013,
      "end": 76.402,
      "speech_end": 76.402
    },
    {
      "id": "L34",
      "text": "就打「摸鱼」。",
      "start": 76.642,
      "end": 77.753,
      "speech_end": 77.753
    },
    {
      "id": "L35",
      "text": "凑够了，",
      "start": 77.993,
      "end": 78.827,
      "speech_end": 78.827
    },
    {
      "id": "L35",
      "text": "就让它打会儿僵尸。",
      "start": 78.947,
      "end": 81.169,
      "speech_end": 81.169
    },
    {
      "id": "L36",
      "text": "你们准的，",
      "start": 81.409,
      "end": 82.52,
      "speech_end": 82.52
    },
    {
      "id": "L36",
      "text": "本鲸不抓。",
      "start": 82.64,
      "end": 83.751,
      "speech_end": 83.751
    },
    {
      "id": "L37",
      "text": "可它也会自己偷偷切屏。",
      "start": 83.991,
      "end": 86.769,
      "speech_end": 86.769
    },
    {
      "id": "L38",
      "text": "那本鲸就要查岗了。",
      "start": 87.009,
      "end": 89.231,
      "speech_end": 89.231
    },
    {
      "id": "L39",
      "text": "抓到了，",
      "start": 89.471,
      "end": 90.304,
      "speech_end": 90.304
    },
    {
      "id": "L39",
      "text": "扣饭钱。",
      "start": 90.424,
      "end": 91.258,
      "speech_end": 91.258
    },
    {
      "id": "L40",
      "text": "诶，",
      "start": 91.498,
      "end": 92.198,
      "speech_end": 92.198
    },
    {
      "id": "L40",
      "text": "刚挣的呀。",
      "start": 92.318,
      "end": 93.429,
      "speech_end": 93.429
    },
    {
      "id": "L41",
      "text": "想帮它装忙，",
      "start": 93.669,
      "end": 95.058,
      "speech_end": 95.058
    },
    {
      "id": "L42",
      "text": "就打「coding」。",
      "start": 95.298,
      "end": 97.52,
      "speech_end": 97.52
    },
    {
      "id": "L43",
      "text": "凑够了，",
      "start": 97.76,
      "end": 98.593,
      "speech_end": 98.593
    },
    {
      "id": "L43",
      "text": "游戏立刻关掉，",
      "start": 98.713,
      "end": 100.38,
      "speech_end": 100.38
    },
    {
      "id": "L44",
      "text": "切回代码。",
      "start": 100.62,
      "end": 101.731,
      "speech_end": 101.731
    },
    {
      "id": "L45",
      "text": "还可以喊「老大」，",
      "start": 101.971,
      "end": 103.638,
      "speech_end": 103.638
    },
    {
      "id": "L46",
      "text": "催本鲸早点来。",
      "start": 103.878,
      "end": 105.544,
      "speech_end": 105.544
    },
    {
      "id": "L47",
      "text": "所以你们一边帮它藏，",
      "start": 105.784,
      "end": 108.284,
      "speech_end": 108.284
    },
    {
      "id": "L48",
      "text": "一边又叫本鲸抓。",
      "start": 108.524,
      "end": 110.469,
      "speech_end": 110.469
    },
    {
      "id": "L49",
      "text": "到底帮谁的呀？",
      "start": 110.709,
      "end": 112.376,
      "speech_end": 112.376
    },
    {
      "id": "L50",
      "text": "本鲸来了，",
      "start": 112.616,
      "end": 113.727,
      "speech_end": 113.727
    },
    {
      "id": "L51",
      "text": "还会问问你们。",
      "start": 113.967,
      "end": 115.633,
      "speech_end": 115.633
    },
    {
      "id": "L52",
      "text": "它敬业吗？",
      "start": 115.873,
      "end": 116.984,
      "speech_end": 116.984
    },
    {
      "id": "L53",
      "text": "代码能跑吗？",
      "start": 117.224,
      "end": 118.613,
      "speech_end": 118.613
    },
    {
      "id": "L54",
      "text": "你们来选，",
      "start": 118.853,
      "end": 119.964,
      "speech_end": 119.964
    },
    {
      "id": "L55",
      "text": "它的饭钱，",
      "start": 120.204,
      "end": 121.316,
      "speech_end": 121.316
    },
    {
      "id": "L55",
      "text": "也跟着变。",
      "start": 121.436,
      "end": 122.547,
      "speech_end": 122.547
    },
    {
      "id": "L56",
      "text": "有时候，",
      "start": 122.787,
      "end": 123.62,
      "speech_end": 123.62
    },
    {
      "id": "L56",
      "text": "还能投票放假。",
      "start": 123.74,
      "end": 125.407,
      "speech_end": 125.407
    },
    {
      "id": "L57",
      "text": "不过得凑够票，",
      "start": 125.647,
      "end": 127.313,
      "speech_end": 127.313
    },
    {
      "id": "L58",
      "text": "不能它自己说下班，",
      "start": 127.553,
      "end": 129.776,
      "speech_end": 129.776
    },
    {
      "id": "L59",
      "text": "就抱着碗跑啦。",
      "start": 130.016,
      "end": 131.682,
      "speech_end": 131.682
    },
    {
      "id": "L60",
      "text": "昨天忙来忙去，",
      "start": 131.922,
      "end": 133.589,
      "speech_end": 133.589
    },
    {
      "id": "L61",
      "text": "总算做出了这么个样子。",
      "start": 133.829,
      "end": 136.607,
      "speech_end": 136.607
    },
    {
      "id": "L62",
      "text": "各种 bug，",
      "start": 136.847,
      "end": 138.236,
      "speech_end": 138.236
    },
    {
      "id": "L62",
      "text": "还在修呢。",
      "start": 138.356,
      "end": 139.467,
      "speech_end": 139.467
    },
    {
      "id": "L63",
      "text": "笨鱼在里面敲代码，",
      "start": 139.707,
      "end": 141.929,
      "speech_end": 141.929
    },
    {
      "id": "L64",
      "text": "老大在外面修代码，",
      "start": 142.169,
      "end": 144.391,
      "speech_end": 144.391
    },
    {
      "id": "L65",
      "text": "本鲸两边都得盯。",
      "start": 144.631,
      "end": 146.576,
      "speech_end": 146.576
    },
    {
      "id": "L66",
      "text": "怎么最忙的，",
      "start": 146.816,
      "end": 148.204,
      "speech_end": 148.204
    },
    {
      "id": "L67",
      "text": "还是本鲸呀。",
      "start": 148.444,
      "end": 149.833,
      "speech_end": 149.833
    },
    {
      "id": "L68",
      "text": "本鲸绝不摸鱼。",
      "start": 150.073,
      "end": 151.74,
      "speech_end": 151.74
    }
  ]
}