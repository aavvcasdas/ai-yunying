{
  "measured": true,
  "method": "clauses from measured cues",
  "source_sha256": "8f4124cbe21e0d93bfb9c458cd77bcfa789f8a114e765837b95b8fa1c930fe5c",
  "screens": [
    {
      "line": 1,
      "text": "笨鱼在翻什么？",
      "start": 0.055,
      "speech_end": 1.32,
      "end": 1.56
    },
    {
      "line": 2,
      "text": "它在帮老大找工作。",
      "start": 2.33,
      "speech_end": 4.23,
      "end": 4.47
    },
    {
      "line": 3,
      "text": "老大可能换新工作。",
      "start": 4.98,
      "speech_end": 6.93,
      "end": 7.17
    },
    {
      "line": 4,
      "text": "岗位先扒出来再说。",
      "start": 7.595,
      "speech_end": 9.09,
      "end": 9.33
    },
    {
      "line": 5,
      "text": "它自己鲸落过。",
      "start": 9.67,
      "speech_end": 10.98,
      "end": 11.22
    },
    {
      "line": 6,
      "text": "被刷下来的滋味，它懂。",
      "start": 11.77,
      "speech_end": 13.835,
      "end": 14.075
    },
    {
      "line": 7,
      "text": "真心话全写在总结里：",
      "start": 14.385,
      "speech_end": 16.375,
      "end": 16.375
    },
    {
      "line": 8,
      "text": "简历投出去，",
      "start": 16.375,
      "speech_end": 17.8,
      "end": 17.8
    },
    {
      "line": 9,
      "text": "像石头沉进海里。",
      "start": 17.8,
      "speech_end": 19.32,
      "end": 19.56
    },
    {
      "line": 10,
      "text": "聊两句就没下文。",
      "start": 19.865,
      "speech_end": 21.33,
      "end": 21.33
    },
    {
      "line": 11,
      "text": "要求写得像许愿：",
      "start": 21.33,
      "speech_end": 23.34,
      "end": 23.34
    },
    {
      "line": 12,
      "text": "什么都要会？",
      "start": 23.34,
      "speech_end": 24.87,
      "end": 25.11
    },
    {
      "line": 13,
      "text": "还嫌人学历？",
      "start": 25.335,
      "speech_end": 26.63,
      "end": 26.63
    },
    {
      "line": 14,
      "text": "本鲸看完先沉默。",
      "start": 26.63,
      "speech_end": 28.41,
      "end": 28.65
    },
    {
      "line": 15,
      "text": "它偷偷标了又标，",
      "start": 28.96,
      "speech_end": 30.597,
      "end": 30.597
    },
    {
      "line": 15,
      "text": "一条条筛。",
      "start": 30.597,
      "speech_end": 31.62,
      "end": 31.62
    },
    {
      "line": 16,
      "text": "老大不是程序员。",
      "start": 31.62,
      "speech_end": 33.325,
      "end": 33.325
    },
    {
      "line": 17,
      "text": "敲代码的，",
      "start": 33.325,
      "speech_end": 34.344,
      "end": 34.344
    },
    {
      "line": 17,
      "text": "先划掉。",
      "start": 34.344,
      "speech_end": 35.16,
      "end": 35.16
    },
    {
      "line": 18,
      "text": "太远的，",
      "start": 35.16,
      "speech_end": 35.76,
      "end": 35.76
    },
    {
      "line": 18,
      "text": "标出来。",
      "start": 35.76,
      "speech_end": 36.36,
      "end": 36.6
    },
    {
      "line": 19,
      "text": "太熬人的，",
      "start": 36.915,
      "speech_end": 37.91,
      "end": 37.91
    },
    {
      "line": 19,
      "text": "也标出来。",
      "start": 37.91,
      "speech_end": 38.905,
      "end": 39.145
    },
    {
      "line": 20,
      "text": "米缸和补全，",
      "start": 39.53,
      "speech_end": 40.714,
      "end": 40.714
    },
    {
      "line": 20,
      "text": "老大买的。",
      "start": 40.714,
      "speech_end": 41.7,
      "end": 41.7
    },
    {
      "line": 21,
      "text": "这份力，",
      "start": 41.7,
      "speech_end": 42.705,
      "end": 42.705
    },
    {
      "line": 21,
      "text": "换它出。",
      "start": 42.705,
      "speech_end": 43.71,
      "end": 43.71
    },
    {
      "line": 22,
      "text": "挑好的递过去。",
      "start": 43.71,
      "speech_end": 45.3,
      "end": 45.54
    },
    {
      "line": 23,
      "text": "老大慢慢挑，",
      "start": 46.245,
      "speech_end": 47.468,
      "end": 47.468
    },
    {
      "line": 23,
      "text": "先吃一口饭。",
      "start": 47.468,
      "speech_end": 48.69,
      "end": 48.93
    },
    {
      "line": 24,
      "text": "本鲸能闲着？",
      "start": 49.215,
      "speech_end": 50.28,
      "end": 50.52
    },
    {
      "line": 25,
      "text": "本鲸读评论，",
      "start": 50.96,
      "speech_end": 52.413,
      "end": 52.413
    },
    {
      "line": 25,
      "text": "也帮着留意。",
      "start": 52.413,
      "speech_end": 53.867,
      "end": 53.867
    },
    {
      "line": 25,
      "text": "本鲸绝不摸鱼",
      "start": 53.867,
      "speech_end": 55.32,
      "end": 55.56
    }
  ]
}
