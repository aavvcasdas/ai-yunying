{
  "measured": false,
  "method": "estimated screens for silent sample",
  "screens": [
    {
      "line": 1,
      "text": "笨鱼在翻什么？",
      "start": 0.0,
      "speech_end": 1.791,
      "end": 2.011
    },
    {
      "line": 2,
      "text": "它在帮老大找工作。",
      "start": 2.011,
      "speech_end": 4.399,
      "end": 4.619
    },
    {
      "line": 3,
      "text": "老大可能换新工作。",
      "start": 4.619,
      "speech_end": 7.007,
      "end": 7.227
    },
    {
      "line": 4,
      "text": "岗位先扒出来再说。",
      "start": 7.227,
      "speech_end": 9.615,
      "end": 9.835
    },
    {
      "line": 5,
      "text": "它自己鲸落过。",
      "start": 9.835,
      "speech_end": 11.626,
      "end": 11.846
    },
    {
      "line": 6,
      "text": "被刷下来的滋味，它懂。",
      "start": 11.846,
      "speech_end": 14.533,
      "end": 14.753
    },
    {
      "line": 7,
      "text": "真心话全写在总结里：",
      "start": 14.753,
      "speech_end": 17.439,
      "end": 17.659
    },
    {
      "line": 8,
      "text": "简历投出去，",
      "start": 17.659,
      "speech_end": 19.152,
      "end": 19.372
    },
    {
      "line": 9,
      "text": "像石头沉进海里。",
      "start": 19.372,
      "speech_end": 21.461,
      "end": 21.681
    },
    {
      "line": 10,
      "text": "聊两句就没下文。",
      "start": 21.681,
      "speech_end": 23.771,
      "end": 23.991
    },
    {
      "line": 11,
      "text": "要求写得像许愿：",
      "start": 23.991,
      "speech_end": 26.081,
      "end": 26.301
    },
    {
      "line": 12,
      "text": "什么都要会？",
      "start": 26.301,
      "speech_end": 27.793,
      "end": 28.013
    },
    {
      "line": 13,
      "text": "还嫌人年纪大？",
      "start": 28.013,
      "speech_end": 29.804,
      "end": 30.024
    },
    {
      "line": 14,
      "text": "本鲸看完先沉默。",
      "start": 30.024,
      "speech_end": 32.114,
      "end": 32.334
    },
    {
      "line": 15,
      "text": "它偷偷标了又标，一条条筛。",
      "start": 32.334,
      "speech_end": 35.617,
      "end": 35.837
    },
    {
      "line": 16,
      "text": "老大不是程序员。",
      "start": 35.837,
      "speech_end": 37.927,
      "end": 38.147
    },
    {
      "line": 17,
      "text": "敲代码的，先划掉。",
      "start": 38.147,
      "speech_end": 40.236,
      "end": 40.456
    },
    {
      "line": 18,
      "text": "太远的，标出来。",
      "start": 40.456,
      "speech_end": 42.247,
      "end": 42.467
    },
    {
      "line": 19,
      "text": "太熬人的，也标出来。",
      "start": 42.467,
      "speech_end": 44.856,
      "end": 45.076
    },
    {
      "line": 20,
      "text": "米缸和补全，老大买的。",
      "start": 45.076,
      "speech_end": 47.762,
      "end": 47.982
    },
    {
      "line": 21,
      "text": "这份力，换它出。",
      "start": 47.982,
      "speech_end": 49.773,
      "end": 49.993
    },
    {
      "line": 22,
      "text": "挑好的递过去。",
      "start": 49.993,
      "speech_end": 51.784,
      "end": 52.004
    },
    {
      "line": 23,
      "text": "老大慢慢挑，先吃一口饭。",
      "start": 52.004,
      "speech_end": 54.989,
      "end": 55.209
    },
    {
      "line": 24,
      "text": "本鲸能闲着？",
      "start": 55.209,
      "speech_end": 56.702,
      "end": 56.922
    },
    {
      "line": 25,
      "text": "本鲸读评论，也帮着留意。本鲸绝不摸鱼",
      "start": 56.922,
      "speech_end": 61.698,
      "end": 61.698
    }
  ]
}
